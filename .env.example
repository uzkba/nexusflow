# ============================================================
# .env.example
# Copie para ".env" e preencha com valores reais.
# NUNCA commitar o ".env" real — apenas este arquivo de exemplo.
# As mesmas chaves (com valores reais) devem ser configuradas
# nas variáveis de ambiente do Railway (ou qualquer outro host)
# em Staging e Produção separadamente.
# ============================================================

# --- Banco de dados (Postgres) ---
# Valores abaixo já batem com o serviço "db" do docker-compose.yml
POSTGRES_USER=nexusflow
POSTGRES_PASSWORD=nexusflow_dev_local
POSTGRES_DB=nexusflow_dev
DATABASE_URL=postgresql+asyncpg://nexusflow:nexusflow_dev_local@db:5432/nexusflow_dev

# --- Autenticação (JWT + Refresh Token) ---
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=troque_esta_chave_secreta
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Cookies ---
# Domínio raiz compartilhado entre frontend e API (ver Seção 6.2 do doc de auth)
COOKIE_DOMAIN=.painel.com
COOKIE_SECURE=true
COOKIE_SAMESITE=strict

# --- CORS (apenas se frontend e API não ficarem no mesmo domínio raiz em algum ambiente) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Frontend (Vite exige prefixo VITE_) ---
VITE_API_BASE_URL=http://localhost:8000

# --- ETL / Scheduler ---
SIGA_CSV_URL=
ETL_SCHEDULE_CRON=0 6 * * *

# --- Ambiente ---
ENVIRONMENT=development
# development | staging | production
